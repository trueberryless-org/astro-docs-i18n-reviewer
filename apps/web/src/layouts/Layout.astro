---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Catch common translation mistakes in Astro Docs and Starlight pull requests."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta
      name="description"
      content="Spot common mistakes in Astro docstranslations."
    />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta
      property="og:description"
      content="Spot common mistakes in Astro docstranslations."
    />
    <meta
      property="og:image"
      content="https://astro-docs-i18n-reviewer.netlify.app/og.png"
    />
    <meta
      property="og:image:alt"
      content="Spot common mistakes in Astro docstranslations."
    />
  </head>
  <body>
    <div class="app-container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #000000;
    --bg-surface: #0a0a0a;
    --bg-card: #111111;
    --border-color: #1c1c1c;
    --text-primary: #f0f0f0;
    --text-secondary: #888888;
    --accent: #ff7e33;
    --accent-hover: #e0651b;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      sans-serif;
    display: flex;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .app-container {
    width: 100%;
    max-width: 900px;
  }
</style>
