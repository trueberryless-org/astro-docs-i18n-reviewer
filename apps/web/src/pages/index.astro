---
import Layout from "../layouts/Layout.astro";
import PRForm from "../components/PRForm.astro";
import ReportMarkdown from "../components/ReportMarkdown.astro";
---

<Layout title="Astro Docs Translation Reviewer">
  <main>
    <header class="main-header">
      <h1>Astro Docs Translation Hub</h1>
      <p>Catch common translation mistakes in Astro/Starlight Docs PRs</p>
    </header>

    <PRForm />
    <div id="reportPreview" class="hidden">
      <ReportMarkdown />
    </div>
  </main>
</Layout>

<script>
  import {
    LANGUAGES,
    runTranslationReview,
  } from "@astro-docs-i18n-reviewer/core";
  import type { TranslationReport } from "@astro-docs-i18n-reviewer/core";

  import {
    getReportFilesHtml,
    getReportMarkdown,
    getReportMeta,
    getReportStatsHtml,
  } from "../libs/report";

  const reviewForm = document.getElementById("reviewForm") as HTMLFormElement;
  const analyzeBtn = document.getElementById("analyzeBtn") as HTMLButtonElement;
  const prInput = document.getElementById("prInput") as HTMLInputElement;
  const tokenInput = document.getElementById("tokenInput") as HTMLInputElement;
  const reportPreview = document.getElementById(
    "reportPreview"
  ) as HTMLDivElement;
  const reportMeta = document.getElementById("reportMeta") as HTMLElement;
  const reportStats = document.getElementById("reportStats") as HTMLElement;
  const suggestionsList = document.getElementById(
    "suggestionsList"
  ) as HTMLElement;
  const copyBtn = document.getElementById("copyBtn") as HTMLButtonElement;

  const supportedLocales = [...LANGUAGES.keys()].toSorted();

  let report: TranslationReport | undefined;

  reviewForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    const prUrlOrNumber = prInput.value;
    const githubToken = tokenInput.value;

    if (!prUrlOrNumber || !githubToken) {
      alert("Please fill out all input parameters.");
      return;
    }

    analyzeBtn.disabled = true;
    analyzeBtn.innerText = "Reviewing...";

    try {
      report = await runTranslationReview({ githubToken, prUrlOrNumber });
      reportMeta.textContent = getReportMeta(report);
      reportStats.innerHTML = getReportStatsHtml(report);
      suggestionsList.innerHTML = getReportFilesHtml(report, supportedLocales);
      reportPreview.classList.remove("hidden");
    } catch (error) {
      alert(
        `Execution Error: ${error instanceof Error ? error.message : String(error)}`
      );
    } finally {
      analyzeBtn.disabled = false;
      analyzeBtn.innerText = "Analyze Pull Request";
    }
  });

  copyBtn.addEventListener("click", async () => {
    if (!report) return;

    await navigator.clipboard.writeText(getReportMarkdown(report));

    copyBtn.innerText = "Copied!";
    setTimeout(() => (copyBtn.innerText = "Copy Report"), 2000);
  });
</script>

<style>
  .hidden {
    display: none !important;
  }

  .main-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    margin-bottom: 0.5rem;
    background: linear-gradient(to right, #ff7e33, #e0651b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  p {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  /* File cards rendered by JS */
  :global(.file-card) {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-surface);
  }

  :global(.file-card.passed) {
    border-color: #0d3d2b;
  }

  :global(.file-card.failed) {
    border-color: #3d1c06;
  }

  :global(.file-header) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.7rem 1rem;
    background: var(--bg-card);
    flex-wrap: wrap;
  }

  :global(.file-icon) {
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  :global(.file-path) {
    font-size: 0.8rem;
    color: var(--text-primary);
    flex: 1;
    word-break: break-all;
    opacity: 0.8;
  }

  :global(.badge) {
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 99px;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  :global(.badge-pass) {
    background: #0a2e1e;
    color: #4ade80;
    border: 1px solid #0d3d2b;
  }

  :global(.badge-fail) {
    background: #2a1000;
    color: #fb923c;
    border: 1px solid #3d1c06;
  }

  :global(.comments-list) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  :global(.comment-item) {
    display: flex;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.85rem;
    align-items: flex-start;
  }

  :global(.comment-item:last-child) {
    padding-bottom: 0.9rem;
  }

  :global(.line-badge) {
    font-family: monospace;
    font-size: 0.72rem;
    background: #1a1000;
    color: #fb923c;
    border: 1px solid #3d1c06;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  :global(.comment-body) {
    color: var(--text-primary);
    white-space: pre-wrap;
    line-height: 1.6;
    opacity: 0.9;
  }

  :global(.empty-state) {
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
    padding: 2.5rem 2rem;
  }

  :global(.empty-state p) {
    margin: 0 0 0.5rem;
  }

  :global(.empty-hint) {
    font-size: 0.8rem;
    opacity: 0.6;
    line-height: 1.6;
  }

  :global(.guide-link) {
    font-size: 0.75rem;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
  }

  :global(.guide-link:hover) {
    text-decoration: underline;
  }

  :global(.empty-hint code) {
    font-family: monospace;
    background: var(--bg-card);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    margin: 0 0.1rem;
    border: 1px solid var(--border-color);
  }
</style>
